<odoo>
    <record id="fmdb_device_view_list" model="ir.ui.view">
        <field name="name">fmdb.device.list</field>
        <field name="model">fmdb.device</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="last_seen"/>
                <field name="is_lost"/>
            </tree>
        </field>
    </record>
    <record id="fmdb_device_view_form" model="ir.ui.view">
        <field name="name">fmdb.device.form</field>
        <field name="model">fmdb.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="owner_id"/>
                        <field name="last_seen"/>
                        <field name="is_lost"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fmdb_device_action" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">fmdb.device</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="fmdb_root_menu" name="FindMyDeviceBD" sequence="10"
              groups="base.group_system"/>
    <menuitem id="fmdb_device_menu" name="Devices" parent="fmdb_root_menu"
              action="fmdb_device_action" sequence="10" groups="base.group_system"/>
</odoo>
